@page "/product/{Id:int}"
@using MiniShopee.Models
@inject MiniShopee.Services.CommerceService CommerceService
@inject MiniShopee.Services.CartState Cart
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@(product?.Name ?? "Sản phẩm") - MiniShopee</PageTitle>

@if (loading)
{
    <div class="product-grid" style="margin-top:24px;">
        <div class="card"><div class="skeleton" style="height:400px;border-radius:12px;"></div></div>
        <div class="card" style="padding:24px;display:flex;flex-direction:column;gap:16px;">
            <div class="skeleton" style="height:18px;width:40%;"></div>
            <div class="skeleton" style="height:28px;width:80%;"></div>
            <div class="skeleton" style="height:36px;width:50%;"></div>
            <div class="skeleton" style="height:14px;width:90%;"></div>
            <div class="skeleton" style="height:14px;width:70%;"></div>
            <div class="skeleton" style="height:44px;margin-top:auto;"></div>
        </div>
    </div>
}
else if (product == null)
{
    <div class="empty-state" style="margin-top:60px;">
        <div class="empty-state-icon">😕</div>
        <div class="empty-state-title">Không tìm thấy sản phẩm</div>
        <div class="empty-state-desc">Sản phẩm không tồn tại hoặc đã bị xóa.</div>
        <a class="btn btn-primary mt-3" href="/shop">← Quay lại cửa hàng</a>
    </div>
}
else
{
    <!-- Breadcrumb -->
    <div style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text-3);margin-bottom:20px;flex-wrap:wrap;">
        <a href="/" style="color:var(--text-3);text-decoration:none;">Trang chủ</a>
        <span>›</span>
        <a href="/shop" style="color:var(--text-3);text-decoration:none;">Sản phẩm</a>
        <span>›</span>
        <a href="/shop" style="color:var(--text-3);text-decoration:none;" @onclick:preventDefault @onclick="@(() => Nav.NavigateTo("/shop"))">@product.Category</a>
        <span>›</span>
        <span style="color:var(--text);">@product.Name</span>
    </div>

    <!-- Main detail card -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-bottom:28px;">

        <!-- Ảnh sản phẩm -->
        <div style="background:var(--surface);border-radius:var(--radius-lg);border:1px solid var(--border);overflow:hidden;aspect-ratio:1;display:flex;align-items:center;justify-content:center;">
            @if (!string.IsNullOrEmpty(product.ImageUrl))
            {
                <img src="@product.ImageUrl" alt="@product.Name"
                     style="width:100%;height:100%;object-fit:cover;" />
            }
            else
            {
                <div style="display:flex;flex-direction:column;align-items:center;gap:12px;color:var(--text-3);">
                    <svg width="80" height="80" fill="currentColor" viewBox="0 0 24 24" opacity=".3">
                        <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                    </svg>
                    <span style="font-size:13px;">Chưa có ảnh</span>
                </div>
            }
        </div>

        <!-- Thông tin sản phẩm -->
        <div style="display:flex;flex-direction:column;gap:16px;">

            <!-- Category badge -->
            <div>
                <span class="badge badge-brand" style="font-size:11px;">@product.Category</span>
            </div>

            <!-- Tên -->
            <h1 style="font-size:20px;font-weight:700;line-height:1.4;color:var(--text);margin:0;">@product.Name</h1>

            <!-- Rating & stats -->
            <div style="display:flex;align-items:center;gap:16px;padding:12px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
                <div style="display:flex;align-items:center;gap:4px;">
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <svg width="16" height="16" fill="@(idx < 4 ? "#f59e0b" : "#e2e8f0")" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                    }
                    <span style="font-size:13px;font-weight:600;color:#f59e0b;margin-left:4px;">4.8</span>
                    <span style="font-size:12px;color:var(--text-3);margin-left:2px;">| @(soldCount > 0 ? $"{soldCount:N0} đã bán" : "Mới ra mắt")</span>
                </div>
                <div style="width:1px;height:16px;background:var(--border);"></div>
                <span style="font-size:12px;color:@(product.Stock < 5 ? "var(--danger)" : "var(--text-3)");">
                    @(product.Stock == 0 ? "❌ Hết hàng" : product.Stock < 5 ? $"⚠️ Còn {product.Stock} sản phẩm" : $"✅ Còn hàng ({product.Stock})")
                </span>
            </div>

            <!-- Giá -->
            <div style="display:flex;align-items:baseline;gap:10px;">
                <span style="font-size:30px;font-weight:800;color:var(--brand);">
                    @product.PriceVnd.ToString("N0")đ
                </span>
            </div>

            <!-- Vận chuyển -->
            <div style="background:var(--surface-2);border-radius:10px;padding:12px 14px;display:flex;flex-direction:column;gap:8px;">
                <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
                    <span>🚚</span>
                    <span><strong>Miễn phí vận chuyển</strong> cho đơn từ 150.000đ</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
                    <span>📦</span>
                    <span>Giao hàng <strong>2–3 ngày</strong> làm việc</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
                    <span>🔄</span>
                    <span>Đổi trả miễn phí trong <strong>30 ngày</strong></span>
                </div>
            </div>

            <!-- Size -->
            @if (!string.IsNullOrEmpty(product.AvailableSizes))
            {
                var sizes = product.AvailableSizes.Split(',', StringSplitOptions.RemoveEmptyEntries);
                <div style="display:flex;align-items:flex-start;gap:12px;margin-top:4px;">
                    <span style="font-size:13px;color:var(--text-3);width:80px;padding-top:6px;">Size</span>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        @foreach (var s in sizes)
                        {
                            var size = s.Trim();
                            <button @onclick="() => selectedSize = size"
                                    style="width:44px;height:44px;border-radius:8px;border:2px solid @(selectedSize == size ? "var(--brand)" : "var(--border)");
                                           background:@(selectedSize == size ? "var(--brand-light)" : "var(--surface)");
                                           font-weight:@(selectedSize == size ? "700" : "500");
                                           color:@(selectedSize == size ? "var(--brand)" : "var(--text)");
                                           cursor:pointer;font-size:13px;transition:.12s;">
                                @size
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Số lượng + CTA -->
            <div style="display:flex;flex-direction:column;gap:10px;margin-top:4px;">
                <div style="display:flex;align-items:center;gap:12px;">
                    <span style="font-size:13px;color:var(--text-3);width:80px;">Số lượng</span>
                    <div style="display:flex;align-items:center;border:1.5px solid var(--border);border-radius:8px;overflow:hidden;">
                        <button style="width:36px;height:36px;background:var(--surface-2);border:none;cursor:pointer;font-size:18px;color:var(--text);"
                                @onclick="() => qty = Math.Max(1, qty - 1)">−</button>
                        <span style="width:44px;text-align:center;font-weight:600;font-size:14px;">@qty</span>
                        <button style="width:36px;height:36px;background:var(--surface-2);border:none;cursor:pointer;font-size:18px;color:var(--text);"
                                @onclick="() => qty = Math.Min(product.Stock, qty + 1)">+</button>
                    </div>
                </div>

                <AuthorizeView Roles="Customer,VipCustomer">
                    <Authorized>
                        <div style="display:flex;gap:10px;">
                            <button class="btn btn-secondary" style="flex:1;height:48px;font-size:14px;"
                                    disabled="@(product.Stock == 0)"
                                    @onclick="AddToCart">
                                🛒 Thêm vào giỏ
                            </button>
                            <button class="btn btn-primary" style="flex:1;height:48px;font-size:14px;"
                                    disabled="@(product.Stock == 0)"
                                    @onclick="BuyNow">
                                ⚡ Mua ngay
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-primary" style="height:48px;font-size:14px;display:flex;align-items:center;justify-content:center;" href="/login">
                            Đăng nhập để mua hàng
                        </a>
                    </NotAuthorized>
                </AuthorizeView>

                @if (addMsg != null)
                {
                    <div class="alert alert-success" style="margin:0;padding:10px 14px;font-size:13px;">@addMsg</div>
                }
            </div>
        </div>
    </div>

    <!-- Mô tả + Chi tiết -->
    <div style="display:grid;grid-template-columns:1fr 340px;gap:20px;margin-bottom:28px;">

        <!-- Mô tả sản phẩm -->
        <div style="background:var(--surface);border-radius:var(--radius-lg);border:1px solid var(--border);overflow:hidden;">
            <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:var(--surface-2);">
                <span style="font-weight:700;font-size:14px;">📋 Mô tả sản phẩm</span>
            </div>
            <div style="padding:20px;font-size:14px;line-height:1.8;color:var(--text);">
                <p style="margin:0 0 12px;">@product.Description</p>
                <hr style="border:none;border-top:1px solid var(--border);margin:16px 0;">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                    @foreach (var feature in GetFeatures())
                    {
                        <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
                            <span style="color:var(--brand);">✓</span> @feature
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Chi tiết shop -->
        <div style="display:flex;flex-direction:column;gap:16px;">
            <div style="background:var(--surface);border-radius:var(--radius-lg);border:1px solid var(--border);overflow:hidden;">
                <div style="padding:14px 16px;border-bottom:1px solid var(--border);background:var(--surface-2);">
                    <span style="font-weight:700;font-size:13px;">🏪 Thông tin shop</span>
                </div>
                <div style="padding:16px;display:flex;flex-direction:column;gap:10px;">
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div style="width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--brand),#ff8856);display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;font-weight:800;flex-shrink:0;">M</div>
                        <div>
                            <div style="font-weight:700;font-size:14px;">MiniShopee</div>
                            <div style="font-size:11px;color:var(--text-3);">✅ Shop chính hãng</div>
                        </div>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px;">
                        @foreach (var (label, val) in shopStats)
                        {
                            <div style="background:var(--surface-2);border-radius:8px;padding:10px;text-align:center;">
                                <div style="font-size:15px;font-weight:700;color:var(--brand);">@val</div>
                                <div style="font-size:11px;color:var(--text-3);">@label</div>
                            </div>
                        }
                    </div>
                    <a href="/chat" class="btn btn-secondary" style="width:100%;text-align:center;font-size:13px;margin-top:4px;">
                        💬 Chat với người bán
                    </a>
                </div>
            </div>

            <!-- Cam kết -->
            <div style="background:var(--surface);border-radius:var(--radius-lg);border:1px solid var(--border);padding:16px;display:flex;flex-direction:column;gap:10px;">
                <div style="font-weight:700;font-size:13px;margin-bottom:4px;">🛡️ Cam kết của MiniShopee</div>
                @foreach (var (icon, text) in guarantees)
                {
                    <div style="display:flex;align-items:center;gap:10px;font-size:13px;">
                        <span style="font-size:18px;">@icon</span>
                        <span>@text</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sản phẩm liên quan -->
    @if (related.Count > 0)
    {
        <div style="margin-bottom:28px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                <div style="font-size:16px;font-weight:700;">🔥 Sản phẩm tương tự</div>
                <a href="/shop" style="font-size:13px;color:var(--brand);text-decoration:none;">Xem thêm →</a>
            </div>
            <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:14px;">
                @foreach (var p in related)
                {
                    <a href="/product/@p.Id" style="text-decoration:none;color:inherit;">
                        <div class="product-card" style="cursor:pointer;">
                            <div class="product-img-wrap">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" />
                                }
                                else
                                {
                                    <div class="product-no-img">Chưa có ảnh</div>
                                }
                            </div>
                            <div class="product-body">
                                <div class="product-name" style="font-size:12.5px;">@p.Name</div>
                                <div class="product-footer" style="margin-top:8px;">
                                    <div class="product-price" style="font-size:13px;">@p.PriceVnd.ToString("N0")đ</div>
                                    <span style="font-size:11px;color:var(--text-3);">Còn @p.Stock</span>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    <!-- Đánh giá -->
    <div style="background:var(--surface);border-radius:var(--radius-lg);border:1px solid var(--border);overflow:hidden;margin-bottom:28px;">
        <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:var(--surface-2);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
            <span style="font-weight:700;font-size:14px;">⭐ Đánh giá sản phẩm (@reviews.Count)</span>
            <!-- Lọc sao -->
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                @foreach (var s in new[]{0,5,4,3,2,1})
                {
                    var star = s;
                    var cnt = star == 0 ? reviews.Count : reviews.Count(r => r.Stars == star);
                    <button @onclick="() => starFilter = star"
                            style="padding:3px 10px;border-radius:20px;border:1.5px solid @(starFilter==star?"#f59e0b":"var(--border)");
                                   background:@(starFilter==star?"#fef3c7":"var(--surface)");
                                   color:@(starFilter==star?"#92400e":"var(--text-3)");font-size:12px;font-weight:@(starFilter==star?"700":"500");cursor:pointer;">
                        @(star==0 ? $"Tất cả ({cnt})" : $"{star}⭐ ({cnt})")
                    </button>
                }
            </div>
        </div>

        <!-- Summary -->
        @{
            var avgRating = reviews.Count > 0 ? reviews.Average(r => r.Stars) : 0.0;
        }
        <div style="padding:20px;display:flex;gap:32px;border-bottom:1px solid var(--border);">
            <div style="text-align:center;flex-shrink:0;">
                <div style="font-size:48px;font-weight:800;color:var(--brand);line-height:1;">@avgRating.ToString("F1")</div>
                <div style="display:flex;justify-content:center;gap:2px;margin:6px 0;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var full = i <= (int)avgRating;
                        <svg width="16" height="16" fill="@(full ? "#f59e0b" : "#e2e8f0")" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                    }
                </div>
                <div style="font-size:12px;color:var(--text-3);">@reviews.Count đánh giá</div>
            </div>
            <div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:5px;">
                @foreach (var s in new[]{5,4,3,2,1})
                {
                    var cnt = reviews.Count(r => r.Stars == s);
                    var pct = reviews.Count > 0 ? cnt * 100 / reviews.Count : 0;
                    <div style="display:flex;align-items:center;gap:8px;cursor:pointer;" @onclick="() => starFilter = s">
                        <span style="font-size:12px;color:var(--text-3);width:36px;">@s ⭐</span>
                        <div style="flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden;">
                            <div style="height:100%;width:@(pct)%;background:#f59e0b;border-radius:3px;"></div>
                        </div>
                        <span style="font-size:12px;color:var(--text-3);width:38px;">@cnt (@(pct)%)</span>
                    </div>
                }
            </div>
        </div>

        <!-- Form viết đánh giá -->
        <AuthorizeView Roles="Customer,VipCustomer">
            <Authorized>
                @if (myReview == null && !showReviewForm)
                {
                    <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:var(--surface-2);">
                        <button class="btn btn-secondary" @onclick="() => showReviewForm = true">✏️ Viết đánh giá</button>
                    </div>
                }
                @if (showReviewForm || myReview != null)
                {
                    <div style="padding:18px 20px;border-bottom:1px solid var(--border);background:var(--surface-2);">
                        <div style="font-weight:700;font-size:13px;margin-bottom:12px;">
                            @(myReview != null ? "✏️ Đánh giá của bạn" : "✍️ Viết đánh giá")
                        </div>
                        <!-- Chọn sao -->
                        <div style="display:flex;gap:4px;margin-bottom:10px;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                var s = i;
                                <svg @onclick="() => newStars = s" width="28" height="28"
                                     fill="@(s <= newStars ? "#f59e0b" : "#e2e8f0")"
                                     viewBox="0 0 20 20" style="cursor:pointer;">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                </svg>
                            }
                            <span style="font-size:13px;color:var(--text-3);margin-left:6px;align-self:center;">
                                @(newStars switch { 5=>"Xuất sắc",4=>"Tốt",3=>"Bình thường",2=>"Tệ",_=>"Rất tệ" })
                            </span>
                        </div>
                        <textarea class="form-control" style="margin-bottom:10px;resize:vertical;" rows="3"
                                  @bind="newComment" placeholder="Chia sẻ trải nghiệm của bạn về sản phẩm..."></textarea>
                        @if (!string.IsNullOrEmpty(reviewMsg))
                        { <div class="alert alert-success" style="margin-bottom:8px;padding:8px 12px;">@reviewMsg</div> }
                        <div style="display:flex;gap:8px;">
                            <button class="btn btn-primary btn-sm" @onclick="SubmitReview" disabled="@submittingReview">
                                @(submittingReview ? "Đang lưu..." : myReview != null ? "Cập nhật" : "Gửi đánh giá")
                            </button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => showReviewForm = false">Hủy</button>
                        </div>
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        <!-- Review list -->
        <div>
            @{
                var filtered = starFilter == 0 ? reviews : reviews.Where(r => r.Stars == starFilter).ToList();
            }
            @if (!filtered.Any())
            {
                <div style="padding:24px;text-align:center;color:var(--text-3);font-size:13px;">
                    Chưa có đánh giá @(starFilter > 0 ? $"{starFilter} sao" : "") nào
                </div>
            }
            @foreach (var r in filtered)
            {
                <div style="padding:18px 20px;border-bottom:1px solid var(--border);">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                        <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#667eea,#764ba2);display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:14px;flex-shrink:0;">
                            @((r.User?.FullName ?? "?")[0])
                        </div>
                        <div style="flex:1;">
                            <div style="font-weight:600;font-size:13px;">@(r.User?.FullName ?? "Ẩn danh")</div>
                            <div style="display:flex;align-items:center;gap:4px;">
                                @for (int i = 1; i <= 5; i++)
                                { <svg width="12" height="12" fill="@(i<=r.Stars?"#f59e0b":"#e2e8f0")" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg> }
                                <span style="font-size:11px;color:var(--text-3);margin-left:4px;">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                        <div style="display:flex;gap:6px;align-items:center;">
                            @if (r.IsVerifiedPurchase)
                            { <span class="badge badge-green" style="font-size:10px;">✓ Đã mua</span> }
                            @if (r.IsReported)
                            { <span class="badge badge-yellow" style="font-size:10px;">⚠️ Đã báo cáo</span> }
                            <!-- Admin: xóa -->
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button class="btn btn-danger btn-sm" style="font-size:11px;padding:2px 8px;"
                                            @onclick="() => DeleteReview(r.Id)">🗑 Xóa</button>
                                </Authorized>
                            </AuthorizeView>
                            <!-- Staff: chỉ report -->
                            <AuthorizeView Roles="Staff">
                                <Authorized>
                                    @if (!r.IsReported)
                                    {
                                        <button class="btn btn-ghost btn-sm" style="font-size:11px;padding:2px 8px;"
                                                @onclick="() => ReportReview(r.Id)">🚩 Báo cáo</button>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>
                    <p style="font-size:13.5px;color:var(--text);line-height:1.6;margin:0;">@r.Comment</p>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    Product? product;
    int soldCount;
    int qty = 1;
    string? selectedSize;
    bool loading = true;
    string? addMsg;
    List<Product> related = [];

    // Reviews
    List<ProductReview> reviews = [];
    ProductReview? myReview;
    int starFilter = 0;
    bool showReviewForm;
    int newStars = 5;
    string newComment = "";
    string? reviewMsg;
    bool submittingReview;
    string? currentUserId;
    bool isAdmin;
    bool isStaff;

    static readonly (string, string)[] shopStats = [
        ("Đánh giá", "4.8⭐"), ("Tỉ lệ PH", "98%"), ("Sản phẩm", "6+"), ("Năm HĐ", "2+"),
    ];
    static readonly (string, string)[] guarantees = [
        ("✅","Hàng chính hãng 100%"), ("🔒","Thanh toán an toàn"),
        ("🚚","Miễn phí đổi trả 30 ngày"), ("💬","Hỗ trợ 24/7"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        currentUserId = user?.Id;
        isAdmin = auth.User.IsInRole("Admin");
        isStaff = auth.User.IsInRole("Staff");
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true; qty = 1; addMsg = null; selectedSize = null;
        starFilter = 0; showReviewForm = false; reviewMsg = null;

        product   = await CommerceService.GetProductByIdAsync(Id);
        soldCount = product != null ? await CommerceService.GetProductSoldCountAsync(Id) : 0;
        related   = product != null ? await CommerceService.GetRelatedProductsAsync(product.Category, Id) : [];

        // Load reviews (admin/staff thấy cả hidden)
        reviews = await CommerceService.GetReviewsAsync(Id, isAdmin || isStaff);

        if (currentUserId != null)
        {
            myReview = await CommerceService.GetUserReviewAsync(Id, currentUserId);
            if (myReview != null)
            {
                newStars = myReview.Stars;
                newComment = myReview.Comment;
                showReviewForm = true;
            }
        }

        loading = false;
    }

    IEnumerable<string> GetFeatures() => product?.Category switch
    {
        "Áo thun"  => ["Cotton 100% cao cấp","Co giãn 4 chiều","Thoáng mát cả ngày","Không phai màu","Dễ giặt ủi","Form unisex"],
        "Áo polo"  => ["Vải cá sấu cao cấp","Kháng khuẩn khử mùi","Giữ form tốt","Cổ bẻ thanh lịch","Phù hợp công sở","Nhiều màu sắc"],
        "Áo sơ mi" => ["Chống nhăn vượt trội","Dễ phối đồ","Phù hợp văn phòng","Vải thoáng khí","Đường may tỉ mỉ","Nhiều size"],
        "Áo hoodie"=> ["Nỉ bông dày dặn","Giữ ấm hiệu quả","Form rộng thời trang","Có túi kangaroo","Mũ điều chỉnh được","Unisex"],
        "Áo khoác" => ["Phong cách streetwear","Vải dù nhẹ bền màu","Chống gió nhẹ","Nhiều túi tiện dụng","Kéo khóa chắc chắn","Dễ vệ sinh"],
        _          => ["Chất lượng cao","Thiết kế thời trang","Bền đẹp theo thời gian","Giá hợp lý","Giao hàng nhanh","Đổi trả dễ dàng"],
    };

    void AddToCart()
    {
        if (product == null) return;
        for (int i = 0; i < qty; i++) Cart.Add(product.Id);
        Cart.NotifyChange();
        addMsg = $"✅ Đã thêm {qty} sản phẩm vào giỏ hàng!";
        _ = Task.Delay(2500).ContinueWith(_ => { addMsg = null; InvokeAsync(StateHasChanged); });
    }

    void BuyNow() { AddToCart(); Nav.NavigateTo("/cart"); }

    async Task SubmitReview()
    {
        if (currentUserId == null || product == null) return;
        submittingReview = true;
        myReview = await CommerceService.UpsertReviewAsync(Id, currentUserId, newStars, newComment);
        reviews  = await CommerceService.GetReviewsAsync(Id, isAdmin || isStaff);
        reviewMsg = "✅ Đã lưu đánh giá!";
        showReviewForm = false;
        submittingReview = false;
        _ = Task.Delay(2500).ContinueWith(_ => { reviewMsg = null; InvokeAsync(StateHasChanged); });
    }

    async Task DeleteReview(int id)
    {
        await CommerceService.DeleteReviewAsync(id);
        reviews = await CommerceService.GetReviewsAsync(Id, isAdmin || isStaff);
        myReview = currentUserId != null ? await CommerceService.GetUserReviewAsync(Id, currentUserId) : null;
        if (myReview == null) { newStars = 5; newComment = ""; showReviewForm = false; }
    }

    async Task ReportReview(int id)
    {
        await CommerceService.ReportReviewAsync(id);
        reviews = await CommerceService.GetReviewsAsync(Id, isAdmin || isStaff);
    }
}
