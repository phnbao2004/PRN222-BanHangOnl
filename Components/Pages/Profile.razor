@page "/profile"
@attribute [Authorize]

@using MiniShopee.Models
@using Microsoft.AspNetCore.Components.Forms

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject MiniShopee.Data.AppDbContext Db

<PageTitle>Hồ sơ - MiniShopee</PageTitle>

<div class="page-header">
    <div class="page-title">Hồ sơ của tôi</div>
</div>

@if (user == null)
{
    <div class="text-muted">Đang tải...</div>
}
else
{
    <div class="profile-layout">

        <!-- LEFT -->

        <div>

            <div class="profile-card">

                <div class="avatar-wrap">

                    @if (!string.IsNullOrEmpty(user.AvatarUrl))
                    {
                        <img class="avatar-img" src="@user.AvatarUrl" />
                    }
                    else
                    {
                        <div class="avatar-placeholder">@avatarChar</div>
                    }

                    <label class="avatar-upload-btn" title="Đổi ảnh">

                        <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                        </svg>

                        <InputFile OnChange="OnAvatarChange"
                                   accept="image/*"
                                   style="display:none;" />

                    </label>

                </div>

                <div style="font-size:17px;font-weight:700;margin-bottom:2px;">
                    @user.FullName
                </div>

                <div class="text-muted text-sm">
                    @user.Email
                </div>

                @if (isVip)
                {
                    <div class="vip-badge-big">
                        VIP Member
                    </div>
                }

                <div class="divider"></div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left;">

                    @if (!isStaff)
                    {
                        <div class="stat-card" style="padding:12px;">
                            <div class="stat-label">Tổng chi tiêu</div>
                            <div class="mono fw-700 text-brand" style="font-size:14px;">
                                @user.TotalSpentVnd.ToString("N0")đ
                            </div>
                        </div>
                    }

                    <div class="stat-card" style="padding:12px;">
                        <div class="stat-label">Uy tín</div>
                        <div class="fw-700" style="font-size:20px;">
                            @user.ReputationPoints/10
                        </div>
                    </div>

                </div>

                @if (!isVip)
                {

                    <div style="margin-top:12px;text-align:left;">

                        <div class="text-sm text-muted mb-2">
                            Còn @((1_000_000 - user.TotalSpentVnd).ToString("N0"))đ để lên VIP
                        </div>

                        <div class="progress-bar-wrap">
                            <div class="progress-bar" style="width:@vipPct%;"></div>
                        </div>

                    </div>

                }

            </div>

        </div>


        <!-- RIGHT -->

        <div class="card">

            <div class="card-head">
                Cập nhật thông tin
            </div>

            <div class="card-body">

                <div class="form-row">

                    <div class="form-group">
                        <label class="form-label">Họ và tên</label>
                        <input class="form-control" @bind="user.FullName" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Số điện thoại</label>
                        <input class="form-control"
                               @bind="user.DefaultPhone"
                               placeholder="0901234567" />
                    </div>

                </div>

                <div class="form-group">
                    <label class="form-label">Địa chỉ giao hàng mặc định</label>
                    <input class="form-control"
                           @bind="user.DefaultAddress"
                           placeholder="Số nhà, đường, quận, tỉnh" />
                </div>

                <div class="form-group">
                    <label class="form-label">URL ảnh đại diện</label>
                    <input class="form-control"
                           @bind="user.AvatarUrl"
                           placeholder="https://..." />
                </div>

                @if (!string.IsNullOrEmpty(saveMsg))
                {
                    <div class="alert @(saveOk ? "alert-success" : "alert-danger") mb-3">
                        @saveMsg
                    </div>
                }

                <button class="btn btn-primary"
                        @onclick="Save">
                    Lưu thay đổi
                </button>

            </div>

        </div>

    </div>
}

@code {

    static readonly HashSet<string> _seededEmails = new(StringComparer.OrdinalIgnoreCase)
        { "admin@local", "staff@local", "customer@local", "vip@local" };

    bool isSeededAccount => user != null && _seededEmails.Contains(user.Email ?? "");

    ApplicationUser? user;
    bool isStaff;

    bool isVip;

    string saveMsg = "";

    bool saveOk;

    string avatarChar = "?";

    int vipPct = 0;


    protected override async Task OnInitializedAsync()
    {

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();

        user = await UserManager.GetUserAsync(auth.User);
        isStaff = auth.User.IsInRole("Staff");

        if (user != null)
        {

            isVip =
            await UserManager.IsInRoleAsync(user, "VipCustomer")
            || user.TotalSpentVnd >= 1_000_000;

            avatarChar =
            !string.IsNullOrEmpty(user.FullName)
            ? user.FullName[0].ToString()
            : "?";

            vipPct =
            (int)Math.Min(100, user.TotalSpentVnd * 100 / 1_000_000);

        }

    }


    async Task OnAvatarChange(InputFileChangeEventArgs e)
    {

        if (user == null)
            return;

        var file = e.File;

        if (file.Size > 2 * 1024 * 1024)
        {
            saveMsg = $"Ảnh quá lớn ({file.Size / 1024 / 1024.0:F1}MB). Vui lòng chọn ảnh nhỏ hơn 2MB.";
            saveOk = false;
            StateHasChanged();
            return;
        }

        var buffer = new byte[file.Size];

        await file.OpenReadStream(2 * 1024 * 1024)
        .ReadAsync(buffer);

        user.AvatarUrl =
        $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";

    }


    async Task Save()
    {

        if (user == null)
            return;

        // Reload từ DB để lấy ConcurrencyStamp mới nhất, tránh lỗi concurrency
        var fresh = await UserManager.FindByIdAsync(user.Id);
        if (fresh == null) return;

        fresh.FullName = user.FullName;
        fresh.DefaultPhone = user.DefaultPhone;
        fresh.DefaultAddress = user.DefaultAddress;
        fresh.AvatarUrl = user.AvatarUrl;

        var result = await UserManager.UpdateAsync(fresh);

        if (result.Succeeded)
        {
            // Đảm bảo AvatarUrl lưu vào DB qua EF trực tiếp
            var dbUser = await Db.Users.FindAsync(fresh.Id);
            if (dbUser != null)
            {
                dbUser.AvatarUrl = fresh.AvatarUrl;
                await Db.SaveChangesAsync();
            }

            user = fresh;

            saveMsg = "Đã cập nhật thành công!";

            saveOk = true;

            avatarChar =
            !string.IsNullOrEmpty(user.FullName)
            ? user.FullName[0].ToString()
            : "?";

        }
        else
        {

            saveMsg =
            string.Join(", ",
            result.Errors.Select(e => e.Description));

            saveOk = false;

        }

    }

}