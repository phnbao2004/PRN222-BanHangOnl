@page "/vouchers"
@attribute [Authorize(Roles = "Admin,Staff")]
@using MiniShopee.Models
@inject MiniShopee.Services.CommerceService CommerceService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Quản lý Voucher - MiniShopee</PageTitle>

<div class="page-header-row mb-4">
    <div class="page-header" style="margin-bottom:0;">
        <div class="page-title">🎟️ Quản lý Voucher</div>
        <div class="page-sub">@vouchers.Count voucher đang có</div>
    </div>
    <button class="btn btn-primary" @onclick="ToggleForm">
        @(showForm ? "✕ Đóng" : "+ Tạo voucher mới")
    </button>
</div>

@if (!string.IsNullOrEmpty(msg))
{
    <div class="alert @(msgOk ? "alert-success" : "alert-danger") mb-4">
        @(msgOk ? "✅" : "❌") @msg
    </div>
}

@if (showForm)
{
    <div class="card mb-5">
        <div class="card-head">✨ Tạo voucher mới</div>
        <div class="card-body">

            <!-- Loại voucher -->
            <div class="form-group mb-4">
                <label class="form-label">Loại voucher *</label>
                <div style="display:flex;gap:10px;flex-wrap:wrap;">
                    @foreach (var (t, label, icon, desc) in voucherTypes)
                    {
                        var tt = t;
                        <div @onclick="() => vType = tt"
                             style="flex:1;min-width:160px;border:2px solid @(vType == t ? "var(--brand)" : "var(--border)");border-radius:10px;padding:14px;cursor:pointer;transition:.15s;background:@(vType == t ? "var(--brand-light)" : "var(--surface)");">
                            <div style="font-size:22px;margin-bottom:4px;">@icon</div>
                            <div style="font-weight:700;font-size:13px;color:@(vType == t ? "var(--brand)" : "var(--text)");">@label</div>
                            <div style="font-size:11.5px;color:var(--text-3);margin-top:3px;">@desc</div>
                        </div>
                    }
                </div>
            </div>

            <div class="form-row mb-3">
                <div class="form-group">
                    <label class="form-label">Mã code *</label>
                    <input class="form-control" value="@voucherCode"
                           @oninput="OnCodeInput"
                           placeholder="VD: SUMMER20" style="text-transform:uppercase;font-weight:700;letter-spacing:1px;" />
                </div>
                <div class="form-group">
                    <label class="form-label">Mô tả</label>
                    <input class="form-control" @bind="description" placeholder="Mô tả ngắn..." />
                </div>
            </div>

            <div class="form-row mb-3">
                @if (vType == VoucherType.Percent)
                {
                    <div class="form-group">
                        <label class="form-label">Giảm (%)</label>
                        <input class="form-control" type="number" min="1" max="100" @bind="discountPct" />
                        <span class="form-hint">1–100%</span>
                    </div>
                }
                else if (vType == VoucherType.Fixed)
                {
                    <div class="form-group">
                        <label class="form-label">Giảm (VND)</label>
                        <input class="form-control" type="number" min="1000" step="1000" @bind="discountAmt" />
                        <span class="form-hint">Số tiền cố định được giảm</span>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label">Giá ship được miễn (VND)</label>
                        <input class="form-control" type="number" min="0" step="5000" @bind="shipAmt" />
                        <span class="form-hint">Thường 30.000đ</span>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Đơn tối thiểu (VND)</label>
                    <input class="form-control" type="number" min="0" step="10000" @bind="minOrder" />
                    <span class="form-hint">0 = không yêu cầu</span>
                </div>

                <div class="form-group">
                    <label class="form-label">Ngày hết hạn *</label>
                    <input class="form-control" type="date" @bind="expiredDate" />
                </div>
            </div>

            <div class="form-row mb-4">
                <div class="form-group">
                    <label class="form-label">Tổng lượt dùng tối đa</label>
                    <input class="form-control" type="number" min="0" @bind="maxTotal" />
                    <span class="form-hint">0 = không giới hạn</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Lượt/user tối đa</label>
                    <input class="form-control" type="number" min="1" @bind="maxPerUser" />
                    <span class="form-hint">Mỗi tài khoản dùng tối đa bao nhiêu lần</span>
                </div>
                <div class="form-group" style="display:flex;align-items:flex-end;padding-bottom:2px;">
                    <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                        <input type="checkbox" @bind="vipOnly" />
                        <span>
                            <div class="form-label" style="margin:0;">Chỉ VIP</div>
                            <div class="form-hint" style="margin:0;">Chỉ thành viên VIP mới dùng được</div>
                        </span>
                    </label>
                </div>
            </div>

            <div class="flex gap-2">
                <button class="btn btn-primary" @onclick="Save" disabled="@saving">
                    @(saving ? "⏳ Đang lưu..." : "💾 Tạo voucher")
                </button>
                <button class="btn btn-ghost" @onclick="ToggleForm">Hủy</button>
            </div>
        </div>
    </div>
}

<!-- Danh sách voucher -->
<div style="display:flex;flex-direction:column;gap:12px;">
    @foreach (var v in vouchers)
    {
        var remainTotal = v.MaxUsesTotal > 0 ? $"{v.MaxUsesTotal - v.UsedCount}/{v.MaxUsesTotal}" : "∞";
        var expired = v.ExpiredAt < DateTime.Now;
        var (typeIcon, typeLabel, typeColor) = v.Type switch {
            VoucherType.Percent  => ("💸", $"Giảm {v.DiscountPercent}%", "var(--brand)"),
            VoucherType.Fixed    => ("🏷️", $"Giảm {v.DiscountAmount:N0}đ", "#7c3aed"),
            VoucherType.Freeship => ("🚚", "Freeship", "#16a34a"),
            _ => ("🎟️","","")
        };

        <div style="background:var(--surface);border:1.5px solid @(expired || !v.IsActive ? "var(--border)" : v.Type == VoucherType.Freeship ? "#bbf7d0" : v.VipOnly ? "#fde68a" : "var(--brand)");border-radius:var(--radius-lg);overflow:hidden;opacity:@(expired || !v.IsActive ? "0.55" : "1");">
            <div style="display:grid;grid-template-columns:auto 1fr auto;gap:0;">

                <!-- Left color strip + icon -->
                <div style="width:70px;background:@typeColor;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:16px 0;">
                    <span style="font-size:24px;">@typeIcon</span>
                    <span style="font-size:9px;color:rgba(255,255,255,.9);font-weight:700;text-align:center;padding:0 4px;">@typeLabel</span>
                </div>

                <!-- Center info -->
                <div style="padding:14px 18px;border-left:2px dashed var(--border);border-right:2px dashed var(--border);">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap;">
                        <span style="font-family:monospace;font-size:18px;font-weight:800;letter-spacing:2px;color:var(--text);">@v.Code</span>
                        @if (v.VipOnly) { <span class="badge badge-yellow">👑 VIP</span> }
                        @if (expired) { <span class="badge badge-gray">Hết hạn</span> }
                        else if (!v.IsActive) { <span class="badge badge-gray">Tắt</span> }
                        else { <span class="badge badge-green">● Đang hoạt động</span> }
                    </div>
                    <div style="font-size:12.5px;color:var(--text-2);margin-bottom:8px;">@v.Description</div>
                    <div style="display:flex;gap:14px;flex-wrap:wrap;">
                        @if (v.MinOrderVnd > 0)
                        {
                            <span style="font-size:12px;color:var(--text-3);">🛒 Đơn từ @v.MinOrderVnd.ToString("N0")đ</span>
                        }
                        <span style="font-size:12px;color:var(--text-3);">📅 HH: @v.ExpiredAt.ToString("dd/MM/yyyy")</span>
                        <span style="font-size:12px;color:var(--text-3);">🔢 Tổng lượt còn: @remainTotal</span>
                        <span style="font-size:12px;color:var(--text-3);">👤 Tối đa @v.MaxUsesPerUser lượt/người</span>
                    </div>
                </div>

                <!-- Right actions -->
                <div style="padding:14px 16px;display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between;gap:8px;min-width:120px;">
                    <div style="font-size:22px;font-weight:800;color:@typeColor;text-align:right;">
                        @(v.Type == VoucherType.Percent ? $"{v.DiscountPercent}%" :
                          v.Type == VoucherType.Fixed   ? $"-{v.DiscountAmount:N0}đ" : "Free")
                    </div>
                    <div style="display:flex;gap:6px;">
                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(v.Id)">🗑</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    List<Voucher> vouchers = [];
    bool showForm;
    bool saving;
    string msg = ""; bool msgOk;

    // Form fields
    VoucherType vType = VoucherType.Percent;
    string voucherCode = "", description = "";
    double discountPct = 10, discountAmt = 50_000, shipAmt = 30_000, minOrder = 0;
    int maxTotal = 100, maxPerUser = 1;
    bool vipOnly;
    DateTime expiredDate = DateTime.Today.AddMonths(1);

    static readonly (VoucherType, string, string, string)[] voucherTypes =
    [
        (VoucherType.Percent,  "Giảm %",      "💸", "Giảm theo phần trăm đơn hàng"),
        (VoucherType.Fixed,    "Giảm tiền",   "🏷️", "Giảm số tiền cố định"),
        (VoucherType.Freeship, "Freeship",    "🚚", "Miễn phí vận chuyển"),
    ];

    protected override async Task OnInitializedAsync()
        => vouchers = await CommerceService.GetAllVouchersAsync();

    void OnCodeInput(ChangeEventArgs e) => voucherCode = (e.Value?.ToString() ?? "").ToUpper();

    void ToggleForm()
    {
        showForm = !showForm;
        voucherCode = ""; description = ""; vType = VoucherType.Percent;
        discountPct = 10; discountAmt = 50_000; shipAmt = 30_000;
        minOrder = 0; maxTotal = 100; maxPerUser = 1; vipOnly = false;
        expiredDate = DateTime.Today.AddMonths(1);
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(voucherCode)) { msg = "Vui lòng nhập mã code."; msgOk = false; return; }

        saving = true;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var role = auth.User.IsInRole("Admin") ? "Admin" : "Staff";

        var v = new Voucher
        {
            Code = voucherCode, Description = description,
            Type = vType,
            DiscountPercent = discountPct,
            DiscountAmount = discountAmt,
            ShipAmount = shipAmt,
            MinOrderVnd = minOrder,
            MaxUsesTotal = maxTotal,
            MaxUsesPerUser = maxPerUser,
            VipOnly = vipOnly,
            CreatedByRole = role,
            ExpiredAt = expiredDate.ToUniversalTime(),
            IsActive = true
        };

        try
        {
            await CommerceService.CreateVoucherAsync(v);
            msg = $"Đã tạo voucher {v.Code} thành công!"; msgOk = true;
            showForm = false;
            vouchers = await CommerceService.GetAllVouchersAsync();
        }
        catch { msg = "Mã code đã tồn tại hoặc có lỗi xảy ra."; msgOk = false; }
        saving = false;
    }

    async Task Delete(int id)
    {
        await CommerceService.DeleteVoucherAsync(id);
        vouchers = await CommerceService.GetAllVouchersAsync();
        msg = "Đã xóa voucher."; msgOk = true;
    }
}
